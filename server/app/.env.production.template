# ============================================================================
# TrendZZo BACKEND — PRODUCTION environment template
# ----------------------------------------------------------------------------
# Give this to the deployment team. Fill the <...> placeholders with the REAL
# production secrets in the host's env/secret store (NOT committed to git).
# Values shown are production-appropriate defaults/examples, not dev values.
#
# DO NOT copy the local dev app/.env verbatim — it is set for development
# (APP_ENV=development, USE_MOCK_DATA=true, HERMES_HEADLESS=false) which is
# WRONG for production.
# ============================================================================

# ── Core ────────────────────────────────────────────────────────────────────
APP_ENV=production            # MUST be "production" (enables real APIs + strict checks)
USE_MOCK_DATA=false           # false in prod → real AI, not mock content

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# MongoDB Atlas connection string. MUST NOT be localhost in production.
MONGODB_URL=<prod-mongodb-atlas-uri>
DB_NAME=content_repurposer

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Strong random secret. Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=<strong-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=43200

# ── Social-publishing credential encryption (REQUIRED IN PROD) ─────────────────
# Fernet key used to encrypt stored platform tokens. WITHOUT THIS THE APP
# REFUSES TO START IN PRODUCTION (this is a likely cause of the current 502).
# Generate ONCE and keep stable forever (changing it makes stored creds
# undecryptable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SP_CREDENTIAL_ENCRYPTION_KEY=<fernet-key>

# ── AI / OpenRouter (REQUIRED for real generation) ─────────────────────────────
OPENROUTER_API_KEY=<openrouter-api-key>
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
ENABLE_AI_IMAGE_GENERATION=true

# ── CORS (REQUIRED) ─────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins. Must include the prod frontend.
CORS_ORIGINS=https://trendzzo.hyperminds.tech

# ── Frontend URL (used for OAuth redirects & emails) ───────────────────────────
FRONTEND_URL=https://trendzzo.hyperminds.tech

# ── Email: OTP / notifications ────────────────────────────────────────────────
# Prefer Resend (HTTPS, works on cloud hosts). SMTP is the fallback.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=TrendZZo <noreply@yourdomain>
SMTP_EMAIL=<smtp-sender-email>
SMTP_PASSWORD=<smtp-app-password>

# ── Media storage (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
STORAGE_BACKEND=cloudinary

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=<linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<linkedin-client-secret>
LINKEDIN_REDIRECT_URI=https://trendzzo-be.xyz-app.com/auth/linkedin/callback

# ── Twitter / X OAuth (OAuth2 + PKCE) ──────────────────────────────────────────
TWITTER_CLIENT_ID=<twitter-client-id>
TWITTER_CLIENT_SECRET=<twitter-client-secret>
TWITTER_REDIRECT_URI=https://trendzzo-be.xyz-app.com/social-publishing/callback/twitter

# ── Reddit OAuth (optional; leave blank if unused) ─────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=

# ── Medium OAuth (optional; leave blank if unused) ─────────────────────────────
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=
MEDIUM_REDIRECT_URI=

# ── AWS Bedrock (image gen is OpenRouter now; Bedrock is unused/optional) ──────
# Only needed if Bedrock image generation is ever re-enabled.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_IMAGE_MODEL=amazon.nova-canvas-v1:0

# ── Hermes browser automation (user-assisted publishing) ───────────────────────
# If the server runs Hermes/Playwright, Chromium MUST run headless on a server.
ENABLE_HERMES_PROVIDER=true
ENABLE_HERMES_USER_ASSISTED=true
HERMES_HEADLESS=true                 # MUST be true on a headless server
ENABLE_HERMES_INSTAGRAM=true
ENABLE_HERMES_FACEBOOK=true
ENABLE_HERMES_QUORA=true
# Persistent Chromium profile dir — a writable server path (NOT a Windows path).
HERMES_BROWSER_PROFILE_DIR=/var/lib/trendzzo/hermes/profiles

# ── SleepOps lifecycle engine (keep only if used in prod infra) ────────────────
SLEEPOPS_ENABLED=true
SLEEPOPS_APP_SLUG=trendzzo
SLEEPOPS_APP_NAME=TrendZZo
SLEEPOPS_EC2_INSTANCE_ID=<ec2-instance-id>
SLEEPOPS_EC2_REGION=ap-south-1
SLEEPOPS_IDLE_TIMEOUT_MINUTES=30
SLEEPOPS_HEALTH_ENDPOINT=https://trendzzo-be.xyz-app.com/health
SLEEPOPS_MAX_WAIT_SECONDS=600
SLEEPOPS_POLL_INTERVAL_SECONDS=15
SLEEPOPS_SCHEDULER_INTERVAL_SECONDS=60

# ── Mongo pool tuning (optional; defaults are fine) ────────────────────────────
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=5
# MONGO_MAX_IDLE_MS=30000
# MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
