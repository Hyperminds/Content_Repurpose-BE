# ─── TrendZZo Backend Environment Template ───────────────────────────────────
# Copy this and fill in real values in Render → Environment Variables
# NEVER commit the real .env to git

# ── App Mode ──────────────────────────────────────────────────────────────────
APP_ENV=production           # development | staging | production
USE_MOCK_DATA=true           # true = mock AI (saves credits) | false = real AI

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/content_repurposer?appName=Cluster0
DB_NAME=content_repurposer

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=43200

# ── AI ────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# AI image generation reuses OPENROUTER_API_KEY above (no second key). Only the
# default image MODEL is configurable here — swap it to change models without
# code changes. Must be an image-capable OpenRouter model.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# ── Email (Gmail App Password — NOT your regular password) ───────────────────
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── CORS (set to your Vercel frontend URL) ────────────────────────────────────
CORS_ORIGINS=https://trendzzo.hyperminds.tech

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://trendzzo.hyperminds.tech

# ── AWS / Workspace Power Control ────────────────────────────────────────────
AWS_REGION=ap-south-1
INSTANCE_ID=i-0219c11f642a8d920
POWER_CONTROLLER=ec2
# Workspace auto-shutdown (disabled until Lambda control plane is deployed)
AUTO_SHUTDOWN_ENABLED=false
AUTO_SHUTDOWN_INTERVAL_SECONDS=60
SLEEP_IDLE_TIMEOUT_SECONDS=900

# ── Cloudinary (image storage — replaces local disk uploads) ─────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_REDIRECT_URI=https://your-render-app.onrender.com/auth/linkedin/callback

# ── Twitter/X OAuth (OAuth 2.0 + PKCE) ────────────────────────────────────────
# Social Publishing Engine callback path is generic: /social-publishing/callback/twitter
TWITTER_CLIENT_ID=your-client-id
TWITTER_CLIENT_SECRET=your-client-secret
TWITTER_REDIRECT_URI=https://your-backend-domain/social-publishing/callback/twitter

# ── Reddit OAuth ──────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://your-render-app.onrender.com/platforms/reddit/callback

# ── Medium OAuth ──────────────────────────────────────────────────────────────
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=
MEDIUM_REDIRECT_URI=https://your-render-app.onrender.com/platforms/medium/callback

# ── Hybrid Publishing feature flags (all default false) ───────────────────────
# Experimental providers are OFF unless explicitly enabled. The native-API
# publishing path (LinkedIn / Meta / X) is always available regardless.
ENABLE_HERMES_PROVIDER=false
ENABLE_HERMES_USER_ASSISTED=false
ENABLE_BYOK_PROVIDERS=false

# ── Hermes runtime tuning (optional; safe defaults apply) ──────────────────────
# HERMES_CONNECTION_TIMEOUT=30
# HERMES_NAVIGATION_TIMEOUT=45
# HERMES_ACTION_TIMEOUT=30
# HERMES_PUBLISH_TIMEOUT=120
# HERMES_OPERATION_TIMEOUT=300
# HERMES_MAX_MEDIA_BYTES=52428800

# ── Reddit user-assisted browser (Hermes) ─────────────────────────────────────
# The Reddit workflow drives a REAL browser via Playwright. It is OFF by
# default (ENABLE_HERMES_PROVIDER=false above). It NEVER stores Reddit
# passwords, never bypasses MFA/CAPTCHA, and never publishes without an
# explicit user confirmation.
#
# Requires (only when ENABLE_HERMES_PROVIDER=true):
#   pip install playwright
#   python -m playwright install chromium
#
# HERMES_HEADLESS: run the browser without a visible window. Keep false so the
#   user can complete sign-in / MFA and see what will be posted before
#   confirming. Set true only for headless environments where a human still
#   drives confirmation out of band.
# HERMES_HEADLESS=false
#
# HERMES_BROWSER_PROFILE_DIR: on-disk directory for the persistent browser
#   profile (keeps the Reddit login session between prepare and confirm so the
#   user is not asked to sign in again). Defaults to a temp dir. Only session
#   cookies live here — no Trendzzo secrets are written.
# HERMES_BROWSER_PROFILE_DIR=/var/lib/trendzzo/hermes-profiles
#
# HERMES_CONFIRMATION_SWEEP_SECONDS: how often the background worker expires
#   pending confirmations that were never confirmed (bounded lifetime, no
#   auto-retry). Default 60.
# HERMES_CONFIRMATION_SWEEP_SECONDS=60
